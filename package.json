{
  "name": "emberglass",
  "version": "0.0.0",
  "private": true,
  "description": "Self-hosted virtual tabletop for in-person play, compatible with 5th edition (SRD 5.1).",
  "license": "AGPL-3.0-only",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "shared",
    "server",
    "client",
    "e2e"
  ],
  "scripts": {
    "start": "node scripts/start.mjs",
    "dev": "npm run dev -w @emberglass/server",
    "build": "tsc -b server/tsconfig.build.json && npm run build -w @emberglass/client",
    "migrate": "npm run migrate -w @emberglass/server",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "e2e": "npm test -w @emberglass/e2e",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "smoke": "node scripts/smoke.mjs",
    "scan-secrets": "node scripts/scan-secrets.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@secretlint/secretlint-rule-preset-recommend": "^13.0.5",
    "@types/node": "^24.13.6",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "prettier": "^3.9.9",
    "secretlint": "^13.0.5",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.1"
  }
}
